{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.19.0/.schema/devbox.schema.json",
  "packages": [
    "zsh@latest",
    "git@latest",
    "oh-my-zsh@latest",
    "zsh-autosuggestions@latest",
    "zsh-syntax-highlighting@latest",
    "zsh-autocomplete@latest"
  ],
  "env": {
    "HOME": "$DEVBOX_PROJECT_ROOT/.devbox/home",
    "ZDOTDIR": "$DEVBOX_PROJECT_ROOT/zsh",
    "LANG": "en_US.UTF-8"
  },
  "shell": {
    "init_hook": [
      "mkdir -p \"$HOME\"",
      "exec zsh"
    ]
  }
}
